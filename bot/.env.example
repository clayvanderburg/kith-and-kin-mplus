# Discord Bot Configuration
# Obtain your Bot Token and Application ID from https://discord.com/developers/applications

DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here
# Public Key found in General Information on the Discord Developer Portal (required for serverless Netlify hosting)
DISCORD_PUBLIC_KEY=your_public_key_here

# (Optional) Guild ID for instant slash command development & testing
GUILD_ID=your_guild_server_id_here

# URL of the shared sync API (Netlify function or deployed backend)
# e.g. https://kith-and-kin-mplus.netlify.app/api/state
API_URL=https://kith-and-kin-mplus.netlify.app/api/state

# Secret token to protect the sync endpoint from unauthorized writes
SYNC_SECRET=kith_and_kin_mythic_key_2026
